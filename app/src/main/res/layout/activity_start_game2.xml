<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. ภาพพื้นหลัง (รวมมาสคอตแมวส้มในฉากเรียบร้อยแล้ว) -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_start_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. โลโก้ชื่อเกม Interview Day! -->
    <ImageView
        android:id="@+id/imgLogoTitle"
        android:layout_width="360dp"
        android:layout_height="160dp"
        android:layout_marginTop="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img_logo_interview_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.84"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. ปุ่มกด START GAME -->
    <ImageButton
        android:id="@+id/btnStartGame"
        android:layout_width="240dp"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_start_game"
        app:layout_constraintEnd_toEndOf="@id/imgLogoTitle"
        app:layout_constraintStart_toStartOf="@id/imgLogoTitle"
        app:layout_constraintTop_toBottomOf="@id/imgLogoTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>